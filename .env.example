# Server Port
PORT=3000

# ISP Backend Internal API URL (Private IP or VPN address)
# Example for production: http://172.168.11.1
ISP_API_URL=http://localhost:8000

# Secret API Key configured in ISP Management system_settings (portal_api_secret)
ISP_API_KEY=your_portal_api_secret

# Chapa Payment Gateway Credentials
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxx
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret

# Public Portal URL (used for payment redirects & callbacks)
PUBLIC_PORTAL_URL=https://pay.yourdomain.com
